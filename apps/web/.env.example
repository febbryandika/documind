# URL of the Hono API (apps/api). Public — read by the browser, and inlined at
# build time, so changing it in production needs a redeploy.
#
# Locally this points straight at the API. In production it points at this app's
# own origin plus the /api-proxy rewrite prefix — for example
#   https://documind.vercel.app/api-proxy
# — so that the API's session cookie is set on the Vercel origin, where proxy.ts
# can read it. See the comment in next.config.ts for why.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Production only, and NOT public: the Fly origin the rewrite forwards to, e.g.
#   https://documind-api.fly.dev
# Leave it unset locally and next.config.ts registers no rewrite at all.
# API_ORIGIN=

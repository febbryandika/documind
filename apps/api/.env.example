# Postgres — matches the docker-compose service at the repo root.
# If 5432 is taken locally, start compose with POSTGRES_PORT=5438 and match it here.
DATABASE_URL=postgresql://documind:documind@localhost:5432/documind

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me
BETTER_AUTH_URL=http://localhost:3001

# Web origin allowed through CORS with credentials (SPEC §14).
WEB_ORIGIN=http://localhost:3000

# Embeddings + generation. Lives only on the API — never in apps/web (SPEC §14).
OPENAI_API_KEY=sk-replace-me

# Langfuse tracing (SPEC §13).
LANGFUSE_PUBLIC_KEY=pk-lf-replace-me
LANGFUSE_SECRET_KEY=sk-lf-replace-me
LANGFUSE_BASEURL=https://cloud.langfuse.com

# Postgres — matches the docker-compose service at the repo root.
# If 5432 is taken locally, start compose with POSTGRES_PORT=5438 and match it here.
#
# Using Neon instead? Strip `&channel_binding=require` from the URL the console
# gives you. It is a libpq-only setting that postgres.js does not implement, so
# postgres.js forwards it as a Postgres *startup* parameter. Neon's proxy
# tolerates that; a plain Postgres answers
#   FATAL: unrecognized configuration parameter "channel_binding"
DATABASE_URL=postgresql://documind:documind@localhost:5432/documind

# Retrieval eval (SPEC §9). A scratch database: `bun run eval` re-ingests the
# fixtures on every run, so it must never point at DATABASE_URL. eval/run.ts
# refuses to start if this is unset or equal to it. Start the container with
#   docker compose --profile eval up -d postgres-eval
EVAL_DATABASE_URL=postgresql://documind:documind@localhost:5433/documind_eval

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me
BETTER_AUTH_URL=http://localhost:3001

# Web origin allowed through CORS with credentials (SPEC §14).
WEB_ORIGIN=http://localhost:3000

# SPEC §11 — the public demo account. src/db/seed.ts creates it and
# src/middleware/demo-user.ts blocks it from uploading and deleting, so the
# demo cannot be wrecked. Both read these, which is what stops them drifting.
#
# Left unset on purpose for local work: demo@documind.app is also the throwaway
# mock session email in four test suites, and an unset DEMO_USER_EMAIL keeps the
# guard inert. Set both wherever the API actually serves the demo, and put the
# password in the README (SPEC §12) — it is meant to be public.
# DEMO_USER_EMAIL=demo@documind.app
# DEMO_USER_PASSWORD=documind-demo

# Embeddings + generation. Lives only on the API — never in apps/web (SPEC §14).
OPENAI_API_KEY=sk-replace-me

# Langfuse tracing (SPEC §13). Leave these unset and tracing simply stays off —
# the API still boots and answers. LANGFUSE_BASE_URL, not LANGFUSE_BASEURL: the
# v3 SDK read the latter, the v4/v5 one this repo installs does not.
LANGFUSE_PUBLIC_KEY=pk-lf-replace-me
LANGFUSE_SECRET_KEY=sk-lf-replace-me
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Port the Bun server listens on. Fly sets this itself.
PORT=3001

# Anything but "production" keeps the postgres pool cached across `--hot` saves.
NODE_ENV=development

{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dump-chunks": "bun run dump-chunks.ts",
    "dump-retrieval": "bun run dump-retrieval.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "bun run src/db/seed.ts",
    "eval": "bun run eval/run.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.47",
    "@hono/zod-validator": "^0.9.0",
    "@langfuse/client": "^5.10.1",
    "@langfuse/otel": "^5.10.1",
    "@langfuse/tracing": "^5.10.1",
    "@langfuse/vercel-ai-sdk": "^5.10.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "ai": "^7.0.79",
    "better-auth": "^1.7.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.3",
    "postgres": "^3.4.9",
    "unpdf": "^1.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
